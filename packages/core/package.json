{
  "name": "@palembang/core",
  "version": "0.5.0",
  "description": "Dependency-free JavaScript Core SDK for rendering the Palembang Graphic System.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybtiger107/palembang-graphic-system.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ybtiger107/palembang-graphic-system/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ybtiger107/palembang-graphic-system/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
